#region Prolog
vDim = 'Time';
IF(DimensionExists(vDim) = 1);
    DimensionDeleteAllElements(vDim);
ELSE;
    DimensionCreate(vDim);
ENDIF;

DimensionDeleteAllElements( vDim );

vAttr1 = 'Month_Name';
vAttr2 = 'Day_Name';
vAttr3 = 'YYYYMMDD';

IF( DIMIX( '}ElementAttributes_Time', vAttr1 ) = 0 ); AttrInsert('Time', '', vAttr1, 'S'); ENDIF;
IF( DIMIX( '}ElementAttributes_Time', vAttr2 ) = 0 ); AttrInsert('Time', '', vAttr2, 'S'); ENDIF;
IF( DIMIX( '}ElementAttributes_Time', vAttr3 ) = 0 ); AttrInsert('Time', '', vAttr3, 'A'); ENDIF;
#endregion
#region Metadata
#############################################################
# METADATA - Builds consolidation hierarchy
# Year > Quarter > Month (leaf)
#############################################################

vMonthNum = SUBST(vISODate,5,2);
vCurrentMonth = vMonthNum | ' '  | vYear;
vCurrentFY = 'FY ' | vYear;

# 1. Create the Elements
DimensionElementInsert(vDim, '', vCurrentFY, 'C');
DimensionElementComponentAdd(vDim, vCurrentFY, vQuarter, 1);
DimensionElementComponentAdd(vDim, vQuarter,vCurrentMonth, 1);

#endregion
#region Data
#############################################################
# DATA - Fires for every row returned by the SQL query
# Writes all attribute values to each leaf element
#############################################################

MonthNum = SUBST(vISODate,5,2);
vCurrentMonth = vMonthNum | ' '  | vYear;
vCurrentFY = 'FY ' | vYear;

# Assign values to the leaf level (Date)
AttrPutS(vMonth_Name, vDim, vCurrentMonth, vAttr1);
AttrPutS(vDay_Name, vDim, vCurrentMonth, vAttr2);
AttrPutS(vLong_Date03, vDim, vCurrentMonth,vAttr3);
#endregion