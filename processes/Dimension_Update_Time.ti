      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '02-' | svCurrentYear  | ' YTD';
      svQuarter = svQ1;
   ENDIF;

   IF (nvMonthCounter = 2) ;
      svMonthAlias =   'Feb-' | svCurrentYear;
      svMonth =  '02-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '03-' | svCurrentYear | ' YTD';
      svQuarter = svQ1;
   ENDIF;

   IF (nvMonthCounter = 3) ;
      svMonthAlias =   'Mar-' | svCurrentYear;
      svMonth =  '03-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '04-' | svCurrentYear | ' YTD';
      svQuarter = svQ1;
   ENDIF;

   IF (nvMonthCounter = 4) ;
      svMonthAlias =   'Apr-' | svCurrentYear;
      svMonth =  '04-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '05-' | svCurrentYear | ' YTD';
      svQuarter = svQ2;
   ENDIF;

  IF (nvMonthCounter = 5) ;
      svMonthAlias =   'May-' | svCurrentYear;
      svMonth =  '05-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '06-' | svCurrentYear | ' YTD';
      svQuarter = svQ2;  	
ENDIF;

  IF (nvMonthCounter = 6) ;
      svMonthAlias =   'Jun-' | svCurrentYear;
      svMonth =  '06-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '07-' | svCurrentYear | ' YTD';
      svQuarter = svQ2;
  ENDIF;

  IF (nvMonthCounter = 7) ;
      svMonthAlias =   'Jul-' | svCurrentYear;
      svMonth =  '07-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '08-' | svCurrentYear | ' YTD';
      svQuarter = svQ3;     
  ENDIF;

  IF (nvMonthCounter = 8) ;
      svMonthAlias =   'Aug-' | svCurrentYear;
      svMonth =  '08-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '09-' | svCurrentYear | ' YTD';
      svQuarter = svQ3;
   ENDIF;

  IF (nvMonthCounter = 9) ;
      svMonthAlias =   'Sep-' | svCurrentYear;
      svMonth =  '09-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '10-' | svCurrentYear | ' YTD';
      svQuarter = svQ3; 
  ENDIF;

  IF (nvMonthCounter = 10) ;
      svMonthAlias =   'Oct-' | svCurrentYear;
      svMonth =  '10-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '11-' | svCurrentYear | ' YTD';
      svQuarter = svQ4;
  ENDIF;

  IF (nvMonthCounter = 11) ;
      svMonthAlias =   'Nov-' | svCurrentYear;
      svMonth =  '11-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = '12-' | svCurrentYear | ' YTD';
      svQuarter = svQ4;
  ENDIF;

  IF (nvMonthCounter = 12) ;
      svMonthAlias =   'Dec-' | svCurrentYear;
      svMonth =  '12-' | svCurrentYear;
      svMonth_YTD =  svMonth | ' YTD';
      svMonth_YTDAlias = svMonthAlias | ' YTD';
      svNext_Month_YTD = svCurrentYear | ' YTD' ;
      svQuarter = svQ4;
  ENDIF;
##############################


 ATTRPUTS(svMonthAlias, DimName, svMonth , vsAttribute0);


 ATTRPUTS(svMonth_YTDAlias, DimName, svMonth_YTD , vsAttribute0);


nvMonthCounter = nvMonthCounter+1;

END;


ExecuteProcess( 'Dimension_Update_Time_Attributes' );
