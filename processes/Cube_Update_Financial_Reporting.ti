#region Data
#############################################################
# DATA - Fires for every row returned by the SQL query
# Writes all attribute values to each leaf element
#############################################################

vCurrentAcct = vGL_Number;
vCurrentDiv = SUBST(vSegment2, 1,2);
vCurrentLoc = SUBST(vSegment2, 3,1);
vCurrentDept = SUBST(vSegment2, 4,2);




CELLPUTN( vJan, vCube, vVersion,'Local_Currency' ,vCompany, vCurrentDiv,VCurrentDept, vCurrentLoc, 'Jan-' | pYear, vCurrentAcct, 'Amount' );

CELLPUTN( vFeb, vCube, vVersion,'Local_Currency' ,vCompany, vCurrentDiv,VCurrentDept, vCurrentLoc, 'Feb-' | pYear, vCurrentAcct, 'Amount' );

CELLPUTN( vMar, vCube, vVersion,'Local_Currency' ,vCompany, vCurrentDiv,VCurrentDept, vCurrentLoc, 'Mar-' | pYear, vCurrentAcct, 'Amount' );

