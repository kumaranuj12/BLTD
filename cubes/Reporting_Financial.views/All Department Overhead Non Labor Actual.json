					"@id":"Dimensions('Time')/Hierarchies('Time')"
				},
				"Alias":"Description",
				"Expression":"{[Time].[Time].[01-2026],[Time].[Time].[02-2026],[Time].[Time].[03-2026],[Time].[Time].[04-2026],[Time].[Time].[05-2026],[Time].[Time].[06-2026],[Time].[Time].[07-2026],[Time].[Time].[08-2026],[Time].[Time].[09-2026],[Time].[Time].[10-2026],[Time].[Time].[11-2026],[Time].[Time].[12-2026],[Time].[Time].[FY-2026]}"
