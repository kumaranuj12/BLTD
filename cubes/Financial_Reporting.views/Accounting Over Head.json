{
	"@type":"NativeView",
	"Name":"Accounting Over Head",
	"Columns":
	[
		{
			"Subset":
			{
				"Hierarchy":
				{
					"@id":"Dimensions('Time')/Hierarchies('Time')"
				},
				"Alias":"Description",
				"Expression":"{TM1FILTERBYLEVEL(TM1DRILLDOWNMEMBER(DISTINCT(DESCENDANTS([Time].[Time].[FY-2026])) , ALL , RECURSIVE) , 0)}"
			}
		}
	],
